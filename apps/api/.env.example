NODE_ENV=development
PORT=3000

DATABASE_URL=postgresql://infusion:infusion_dev_password@localhost:5432/infusion_platform

REDIS_HOST=localhost
REDIS_PORT=6379

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-a-64-char-hex-secret-min-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=replace-with-a-different-64-char-hex-secret-min-32-chars
JWT_REFRESH_TTL=7d

CORS_ORIGINS=http://localhost:5173

# Path attribute for the refresh-token cookie. Must match the PUBLIC path
# the browser sees for /auth/*. Leave as /auth for local dev. In prod behind
# a reverse proxy that strips a path prefix (e.g. this api is served at
# /api/* and the proxy forwards /api/auth/* -> /auth/*), set this to
# /api/auth or the cookie will silently stop round-tripping.
REFRESH_COOKIE_PATH=/auth

# Vigil ECMO monitoring (docs/vigil/README.md). One switch, read at start-up:
#   false (default) = TEST: simulated patient scenarios, machine ingest refused
#   true            = LIVE: HL7 PCD-01 from registered ECMO machines via
#                     POST /vigil/ingest; needs VIGIL_LIVE_TENANT_ID/UNIT_ID
VIGIL_LIVE_MODE=false
# TEST mode
VIGIL_TEST_SCENARIO=ecmo/oxy_clot_01
VIGIL_TEST_SPEED=60
# VIGIL_TEST_AUTOSTART=true
# VIGIL_TEST_TENANT_ID=sim-hospital     (must start with "sim")
# VIGIL_TEST_UNIT_ID=sim-icu-1          (must start with "sim")
# LIVE mode
# VIGIL_LIVE_TENANT_ID=general-hospital (required, must not start with "sim")
# VIGIL_LIVE_UNIT_ID=cvicu-3            (required, must not start with "sim")
# VIGIL_HL7_CODES={"MDC:QB":"ECMO_BLOOD_FLOW"}
# VIGIL_TICK_SECONDS=1

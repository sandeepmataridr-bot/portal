NODE_ENV=development
PORT=3000

DATABASE_URL=postgresql://infusion:infusion_dev_password@localhost:5432/infusion_platform

REDIS_HOST=localhost
REDIS_PORT=6379

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-a-64-char-hex-secret-min-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=replace-with-a-different-64-char-hex-secret-min-32-chars
JWT_REFRESH_TTL=7d

CORS_ORIGINS=http://localhost:5173

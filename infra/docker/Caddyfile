# The staff app at https://app.0dh.in: static SPA + /api reverse proxy.
#
# Visitors reach it as: Cloudflare (TLS) -> Cloudflare Tunnel -> Coolify's
# proxy (Traefik, routes app.0dh.in here) -> this Caddy on plain HTTP :80
# -> api. So Caddy serves no certificates itself. The public home page
# (https://0dh.in) is a separate static site on Cloudflare
# (apps/web/vite.landing.config.ts).
{
	servers {
		# Only proxies on private networks (Traefik, cloudflared) can reach
		# this container; trust the visitor IP they pass on, preferring the
		# one Cloudflare itself sets.
		trusted_proxies static private_ranges
		client_ip_headers Cf-Connecting-Ip X-Forwarded-For
	}
}

# Security headers on every response: the SPA and /api.
#
# The Content Security Policy only lets pages load this site's own scripts,
# styles, fonts and images, and talk only to this site's API and socket — so
# injected markup can't pull in or run anything from elsewhere. The web app
# loads nothing third-party (its fonts are self-hosted); if that ever changes,
# add the origin here and check the browser console for CSP violations.
# Header deletions (-Server) make Caddy apply this block as the response is
# written, so these values also replace any the api sets itself.
(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; font-src 'self'; img-src 'self' data:; connect-src 'self' wss://{$DOMAIN}; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; worker-src 'none'; manifest-src 'self'; upgrade-insecure-requests"
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
		Permissions-Policy "accelerometer=(), autoplay=(), camera=(), display-capture=(), encrypted-media=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), midi=(), payment=(), picture-in-picture=(), publickey-credentials-get=(), screen-wake-lock=(), usb=(), xr-spatial-tracking=(), browsing-topics=()"
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Resource-Policy "same-origin"
		X-Permitted-Cross-Domain-Policies "none"
		Origin-Agent-Cluster "?1"
		# The staff app has no business in search engines.
		X-Robots-Tag "noindex, nofollow"
		-Server
		-X-Powered-By
	}
}

:80 {
	encode gzip zstd
	import security_headers

	# Strip /api before forwarding — the NestJS app has no global prefix,
	# so `/api/auth/login` on the wire becomes `/auth/login` to the api
	# container. Keeps the browser talking to one origin (no CORS, no
	# separate subdomain/cert to manage).
	handle_path /api/* {
		# Patient data must never be kept by the browser's or any proxy's cache.
		header {
			Cache-Control "no-store"
			defer
		}
		reverse_proxy api:3000 {
			# Exactly one address: the visitor's (see `servers` above). The
			# api trusts one proxy hop (TRUST_PROXY_HOPS=1) to read it.
			header_up X-Forwarded-For {client_ip}
		}
	}

	handle {
		root * /srv/web
		try_files {path} /index.html
		file_server
	}
}

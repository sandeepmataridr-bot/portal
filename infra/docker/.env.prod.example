# The staff app's settings. On the Raspberry Pi, enter these in Coolify's
# Environment Variables for docker-compose.pi.yml (docs/deployment.md). For a
# local run of docker-compose.prod.yml, copy to infra/docker/.env.prod
# (gitignored, see repo .gitignore .env.* rule). Never commit real values.

# The staff app's public address (Cloudflare Tunnel -> Coolify -> web).
DOMAIN=app.0dh.in
# The public home page, hosted separately on Cloudflare; the app's own root
# opens the staff entry point instead (build-time, docker-compose.prod.yml).
LANDING_URL=https://0dh.in

# First deploy only: also create the initial accounts (forced password change)
# and reference data. Set back to false afterwards.
RUN_SEED=false

POSTGRES_USER=infusion
# Generate with: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
POSTGRES_PASSWORD=replace-me
POSTGRES_DB=infusion_platform

# Generate each with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must be two DIFFERENT values — access and refresh tokens are signed with
# separate secrets so a leaked access-token secret alone can't forge refresh
# tokens.
JWT_ACCESS_SECRET=replace-me-64-hex-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=replace-me-different-64-hex-chars
JWT_REFRESH_TTL=7d

# Vigil ECMO monitoring (docs/vigil/, ADR-005/006).
# LIVE: ECMO machines and the ESP32 gateway (docs/vigil/esp32.md) send their
# data to /api/vigil/ingest, and it is handled as real information. Nothing
# changes on the server when the readings become real, but WHERE it runs must:
# while this deployment is not covered for real patient data (free hosting, no
# signed BAA/DPA, e.g. a home Raspberry Pi), send only dummy readings and
# register only made-up patients, and move to covered hosting before a real
# patient is connected.
# LIVE needs VIGIL_LIVE_TENANT_ID/UNIT_ID (must not start with "sim").
# VIGIL_LIVE_MODE=false is TEST instead: simulated scenarios, machine data refused.
VIGIL_LIVE_MODE=true
VIGIL_LIVE_TENANT_ID=0dh-hospital
VIGIL_LIVE_UNIT_ID=icu-1
# TEST mode only
VIGIL_TEST_SCENARIO=ecmo/oxy_clot_01
VIGIL_TEST_SPEED=60
# Site OBX-3 codes -> Vigil signals, e.g. {"MDC:QB":"ECMO_BLOOD_FLOW"}
# VIGIL_HL7_CODES=

# Quick sign-in accounts (admin1, doctor1, ... one per role) listed WITH THEIR
# PASSWORDS on the login screen. Anyone who can open the login page can then
# sign in as any role, admin included, so only turn this on for a TEST-mode
# demo whose login page is itself protected (e.g. Cloudflare Access). This
# production build ignores it in LIVE mode, and start-up disables those
# accounts whenever it's off.
TEST_LOGINS=false

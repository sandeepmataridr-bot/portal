# Copy to infra/docker/.env.prod and fill in real values. Never commit the
# filled-in file — infra/docker/.env.prod is gitignored (see repo .gitignore
# .env.* rule).

# Public domain this deploys to. DNS A/AAAA record must point at the VPS
# before `docker compose up` — Caddy requests a Let's Encrypt cert for this
# domain on first start and will retry/fail loudly if DNS isn't live yet.
DOMAIN=0dh.in

POSTGRES_USER=infusion
# Generate with: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
POSTGRES_PASSWORD=replace-me
POSTGRES_DB=infusion_platform

# Generate each with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must be two DIFFERENT values — access and refresh tokens are signed with
# separate secrets so a leaked access-token secret alone can't forge refresh
# tokens.
JWT_ACCESS_SECRET=replace-me-64-hex-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=replace-me-different-64-hex-chars
JWT_REFRESH_TTL=7d

# Vigil ECMO monitoring (docs/vigil/, ADR-005/006). Leave TEST mode on for
# any demo or free-tier hosting: it runs simulated patients only and refuses
# machine data. LIVE mode (real ECMO machines, real patients) needs hosting
# covered by a signed BAA/DPA, and VIGIL_LIVE_TENANT_ID/UNIT_ID set (must not
# start with "sim"); Vigil stays disabled until they are.
VIGIL_LIVE_MODE=false
VIGIL_TEST_SCENARIO=ecmo/oxy_clot_01
VIGIL_TEST_SPEED=60
# VIGIL_LIVE_TENANT_ID=general-hospital
# VIGIL_LIVE_UNIT_ID=cvicu-3
# Site OBX-3 codes -> Vigil signals, e.g. {"MDC:QB":"ECMO_BLOOD_FLOW"}
# VIGIL_HL7_CODES=

# Test accounts (test.admin, test.doctor, ... one per role) listed WITH THEIR
# PASSWORDS on the login screen. Anyone who can open the login page can then
# sign in as any role, admin included, so only turn this on for a TEST-mode
# demo whose login page is itself protected (e.g. Cloudflare Access). It is
# ignored in LIVE mode, and start-up disables those accounts whenever it's off.
TEST_LOGINS=false
